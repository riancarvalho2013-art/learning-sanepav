    "/api/courseState": {
      "post": {
        "summary": "Publica, arquiva ou reativa um curso, com revisão obrigatória",
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Sessão ausente ou expirada"
          },
          "403": {
            "description": "Acesso fora do escopo"
          },
          "409": {
            "description": "Conflito de revisão ou integridade"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "revision",
                  "status"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "published",
                      "archived"
                    ]
                  }
                }
              }
            }
          }
        },
        "description": "Administrador ou RH/DHO. Não exclui cursos nem matrículas. Curso legado sem status é publicado e tem revisão zero."
      }
    },
    "/api/user": {
      "post": {
        "summary": "Cria ou edita usuário e vínculo profissional em uma transação",
        "description": "Somente Administrador. organization é opcional para compatibilidade com clientes legados; quando enviado, company_id e revision são obrigatórios. Qualquer erro reverte acesso, credenciais e vínculo.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "role",
                  "active"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "Administrador",
                      "Líder",
                      "Colaborador",
                      "RH/DHO",
                      "Diretoria"
                    ]
                  },
                  "active": {
                    "type": "boolean"
                  },
                  "manager": {
                    "type": "string"
                  },
                  "organization": {
                    "type": "object",
                    "required": [
                      "company_id",
                      "revision"
                    ],
                    "properties": {
                      "company_id": {
                        "type": "string"
                      },
                      "unit_id": {
                        "type": "string"
                      },
                      "department_id": {
                        "type": "string"
                      },
                      "position": {
                        "type": "string"
                      },
                      "hired_at": {
                        "type": "string"
                      },
                      "ended_at": {
                        "type": "string"
                      },
                      "revision": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cadastro e vínculo salvos"
          },
          "400": {
            "description": "Dados ou hierarquia incompatíveis"
          },
          "403": {
            "description": "Sem autorização"
          },
          "409": {
            "description": "Revisão alterada ou cadastro duplicado"
          }
        }
      }
    },
    "/api/mission": {
      "post": {
        "summary": "Cria ou edita trilha",
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Sessão ausente ou expirada"
          },
          "403": {
            "description": "Acesso fora do escopo"
          },
          "409": {
            "description": "Conflito de revisão ou integridade"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "courses"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "courses": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 30,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "sequential": {
                    "type": "boolean"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "description": "A ordem e o modo de estudo ficam preservados após a primeira atribuição explícita. Edição exige revisão."
      }
    },
    "/api/missionAssign": {
      "post": {
        "summary": "Atribui trilha a uma pessoa ou grupo",
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Sessão ausente ou expirada"
          },
          "403": {
            "description": "Acesso fora do escopo"
          },
          "409": {
            "description": "Conflito de revisão ou integridade"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "person": {
                    "type": "string"
                  },
                  "people": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "date": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "description": "Administrador ou RH/DHO. Todas as pessoas devem estar ativas e no escopo. Atribuição atômica e idempotente; novas matrículas recebem os pré-requisitos da trilha."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "learning"
      }
